{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VRBS smoke: debug wiring only",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "/mnt/si00068187c7/default/myc/code/Eagle/Embodied:${env:PYTHONPATH}",
        "HF_ENDPOINT": "https://hf-mirror.com",
        "HF_HUB_DISABLE_XET": "1"
